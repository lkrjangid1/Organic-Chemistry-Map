{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reagents": {
      "type": "string"
    },
    "conditions": {
      "type": "string"
    },
    "byproducts": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "distinguishes": {
      "type": "string"
    },
    "reactantName": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "memoryTricks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "arrows": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "faq": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "translated": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "translated"
  ]
}