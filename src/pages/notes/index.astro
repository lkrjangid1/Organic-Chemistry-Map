---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LibgenCard from '../../components/LibgenCard.astro';
import { SITE, url, absUrl } from '../../lib/site';
import { breadcrumbLd, orgLd, personLd, audienceLd } from '../../lib/seo';

const pdf = 'downloads/organic-chemistry-handwritten-notes.pdf';
const pages = 146;
const sizeMb = 17;
const chapters = [
  ['Reaction-map charts (alkene, alkyne, diazonium)', 1, 3, 'mechanisms/'],
  ['Named reactions: one-line summary', 4, 19, 'reactions/'],
  ['Named reactions in detail: elimination, rearrangements, free radicals, carbenes, SN1/SN2/SNi, benzyne, Grignard', 20, 48, 'mechanisms/'],
  ['Oxidation: ozonolysis, KMnO₄, SeO₂, HIO₄, PCC, PDC, Jones, Oppenauer', 49, 54, null],
  ['Reduction: Lindlar, Birch, Clemmensen, Wolff–Kishner, LiAlH₄, NaBH₄, DIBAL-H, MPV', 55, 62, null],
  ['Aldehydes and ketones: aldol, Cannizzaro, Perkin, Michael, benzoin, Reformatsky, tests', 63, 80, null],
  ['Carboxylic acids and derivatives: HVZ, haloform, Arndt–Eistert, Curtius, ester hydrolysis', 81, 95, null],
  ['Phenols: cumene process, Claisen, Fries, Elbs, Dakin, Kolbe–Schmitt', 96, 99, null],
  ['Nitrogen compounds: Gabriel, Lossen, Hinsberg, nitro reduction, aniline, azo dyes', 100, 113, null],
  ['Polymerisation of aldehydes; tests for functional groups', 114, 119, null],
  ['Purification of organic compounds; boiling-point trends', 120, 122, null],
  ['Biomolecules and polymers: sugars, amino acids, polymers table', 123, 129, null],
  ['General organic chemistry: acids and bases, inductive effect, hyperconjugation, resonance, aromaticity', 130, 144, null],
  ['Stability criteria, ortho effect, IUPAC prefixes and suffixes', 145, 146, null],
] as const;

const path = 'notes/';
const description = `Free organic chemistry handwritten notes PDF for JEE Main, JEE Advanced and NEET: ${pages} pages of named reactions, mechanisms, oxidation, reduction and GOC.`;
const jsonLd = [
  {
    '@type': ['DigitalDocument', 'LearningResource'],
    name: 'Organic Chemistry Handwritten Notes (JEE & NEET)',
    description,
    url: absUrl(path),
    encodingFormat: 'application/pdf',
    contentUrl: absUrl(pdf),
    numberOfPages: pages,
    inLanguage: 'en-IN',
    isAccessibleForFree: true,
    author: personLd(),
    publisher: orgLd(),
    audience: audienceLd,
    educationalLevel: 'Class 11–12, competitive entrance exams',
    image: absUrl('notes-preview/notes-page-25.webp'),
  },
  breadcrumbLd([{ name: 'Handwritten notes', path }]),
];
---
<Base title="Organic Chemistry Handwritten Notes PDF for JEE & NEET (Free)" description={description} path={path} jsonLd={jsonLd} section="notes">
  <div class="container page">
    <Breadcrumbs items={[{ label: 'Handwritten notes' }]} />
    <header class="page-head">
      <h1>Organic chemistry handwritten notes PDF</h1>
      <p class="summary">
        {pages} pages of handwritten organic chemistry notes for JEE Main, JEE Advanced and NEET, from named reactions and
        mechanisms to oxidation, reduction, carbonyl compounds, nitrogen compounds and GOC. Free to download, no sign-up.
      </p>
      <p><a class="btn btn-primary" href={url(pdf)} download>Download PDF ({sizeMb} MB)</a></p>
    </header>

    <div class="layout">
      <article class="prose">
        <h2>What's inside</h2>
        <table>
          <thead><tr><th>Topic</th><th>PDF pages</th></tr></thead>
          <tbody>
            {chapters.map(([name, from, to, link]) => (
              <tr><td>{link ? <a href={url(link)}>{name}</a> : name}</td><td>{from}–{to}</td></tr>
            ))}
          </tbody>
        </table>

        <h2>Preview</h2>
        <div class="cards cards-4">
          {[24, 25, 53, 85].map((n) => (
            <img src={url(`notes-preview/notes-page-${n}.webp`)} width="620" height="820" loading="lazy" alt={`Handwritten organic chemistry notes, notebook page ${n}`} style="border:1px solid var(--border);border-radius:10px" />
          ))}
        </div>

        <h2>Read the typed, verified version</h2>
        <p>
          Every reaction in these notes is being rewritten as its own page, with the mechanism, examples, exam tips and
          references checked against NCERT and other trusted sources. Start with the
          <a href={url('reactions/')}>reaction index</a> or the <a href={url('mechanisms/')}>mechanism pages</a>, and use the
          <a href={url('map/')}>interactive map</a> to see how reactions connect.
        </p>

        <h2>About these notes</h2>
        <p>
          {SITE.author.byline}. The photos have been straightened, brightened and converted to black and white for printing.
          Photocopied book pages from the original notebook are not included.
        </p>
        <LibgenCard />
      </article>
      <aside class="side">
        <div class="side-card">
          <h2>Download</h2>
          <p>{pages} pages · PDF · {sizeMb} MB</p>
          <a class="btn btn-primary btn-sm" href={url(pdf)} download>Download PDF</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
