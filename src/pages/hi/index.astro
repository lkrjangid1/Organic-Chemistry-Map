---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { url, absUrl } from '../../lib/site';
import { SECTIONS, type SectionKey } from '../../lib/sections';
import { breadcrumbLd } from '../../lib/seo';

const pages = (await getCollection('hindi')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const path = 'hi/';
const title = 'Organic Chemistry हिंदी में: JEE और NEET के लिए नोट्स';
const description = 'JEE Main, JEE Advanced और NEET के लिए organic chemistry हिंदी में: named reactions, mechanisms, tests और concepts, आसान हिंदी और English technical terms के साथ।';
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: title,
    url: absUrl(path),
    inLanguage: 'hi-IN',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: pages.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: absUrl(`hi/${SECTIONS[p.id.split('/')[0] as SectionKey].path}${p.id.split('/')[1]}/`), name: p.data.title })),
    },
  },
  breadcrumbLd([{ name: 'हिंदी', path }]),
];
---
<Base title={title} description={description} path={path} altPath="" jsonLd={jsonLd}>
  <div class="container page">
    <Breadcrumbs items={[{ label: 'हिंदी' }]} />
    <header class="page-head">
      <h1>Organic chemistry हिंदी में</h1>
      <p class="summary">Reactions, tests और concepts को आसान हिंदी में समझें। Chemistry के technical terms English में ही रखे गए हैं, ताकि exam में वही शब्द याद रहें।</p>
    </header>
    <ul class="list-cards">
      {pages.map((p) => {
        const [section, slug] = p.id.split('/');
        return <li><a class="card" href={url(`hi/${SECTIONS[section as SectionKey].path}${slug}/`)}><strong>{p.data.title}</strong><p>{p.data.description}</p></a></li>;
      })}
    </ul>
    <p>और pages जल्द ही हिंदी में आएँगे। तब तक <a href={url('reactions/')}>English में सभी reactions</a> देखें।</p>
  </div>
</Base>
