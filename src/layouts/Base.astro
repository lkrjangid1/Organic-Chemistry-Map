---
import '../styles/site.css';
import { SITE, absUrl, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, used for canonical/OG url. */
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Top nav section to highlight. */
  section?: 'reactions' | 'tests' | 'mechanisms' | 'concepts' | 'comparisons' | 'preparation' | 'reagents' | 'compounds' | 'map' | 'notes' | 'about';
}

const {
  title,
  description,
  path,
  ogImage = 'og-image.png',
  ogType = 'website',
  jsonLd,
  noindex = false,
  section,
} = Astro.props;

const canonical = absUrl(path);
const image = absUrl(ogImage);
// Add the brand suffix only when it still fits in ~65 characters (Google truncates around 60).
const suffix = ` | ${SITE.name}`;
const fullTitle = title.includes(SITE.name) || title.length + suffix.length > 65 ? title : `${title}${suffix}`;
const ld = jsonLd
  ? JSON.stringify(Array.isArray(jsonLd) ? { '@context': 'https://schema.org', '@graph': jsonLd } : jsonLd).replace(/</g, '\\u003c')
  : null;

const nav = [
  { key: 'reactions', href: url('reactions/'), label: 'Reactions' },
  { key: 'mechanisms', href: url('mechanisms/'), label: 'Mechanisms' },
  { key: 'concepts', href: url('concepts/'), label: 'Concepts' },
  { key: 'reagents', href: url('reagents/'), label: 'Reagents' },
  { key: 'tests', href: url('tests/'), label: 'Tests' },
  { key: 'notes', href: url('notes/'), label: 'Notes' },
];
const more = [
  { key: 'comparisons', href: url('comparisons/'), label: 'Comparisons' },
  { key: 'preparation', href: url('preparation/'), label: 'Preparation' },
  { key: 'compounds', href: url('compounds/'), label: 'Compounds' },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification.replace(/[^\w-]/g, '')} />}

    <link rel="icon" type="image/png" href={url('icons/ogm_logo.png')} />
    <link rel="apple-touch-icon" href={url('icons/ogm_logo.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" content={SITE.themeColor} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url()}>
          <img src={url('icons/ogm_logo.png')} alt="" width="36" height="36" />
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
          <details class="nav-menu">
            <summary>Menu</summary>
            <ul>
              {[...nav, ...more].map((item) => <li><a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a></li>)}
            </ul>
          </details>
          <a class="btn btn-primary btn-sm" href={url('map/')}>Open map</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p><strong>{SITE.name}</strong>: free organic chemistry notes and an interactive reaction map for JEE Main, JEE Advanced and NEET.</p>
          <p>{SITE.author.byline} · {SITE.publisher.credit}</p>
          <p>
            Try <a href={SITE.libgen.url} rel="noopener">{SITE.libgen.name}</a>, a {SITE.libgen.line.toLowerCase()}.
          </p>
        </div>
        <ul class="footer-links">
          <li><a href={url('reactions/')}>Reactions</a></li>
          <li><a href={url('mechanisms/')}>Mechanisms</a></li>
          <li><a href={url('concepts/')}>Concepts</a></li>
          <li><a href={url('comparisons/')}>Comparisons</a></li>
          <li><a href={url('reagents/')}>Reagents</a></li>
          <li><a href={url('tests/')}>Tests</a></li>
          <li><a href={url('preparation/')}>Preparation</a></li>
          <li><a href={url('compounds/')}>Compounds</a></li>
          <li><a href={url('notes/')}>Handwritten notes</a></li>
          <li><a href={url('map/')}>Interactive map</a></li>
          <li><a href={url('about/')}>About</a></li>
          <li><a href={url('privacy/')}>Privacy</a></li>
          <li><a href={SITE.repo} rel="noopener">GitHub</a></li>
        </ul>
      </div>
    </footer>

    {
      SITE.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfAnalyticsToken })}
        />
      )
    }
  </body>
</html>
