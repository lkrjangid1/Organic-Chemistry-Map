---
/** Page template for concepts, comparisons, preparation methods and reagents. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Eq from '../Eq.astro';
import Mol from '../Mol.astro';
import KeyPoint from '../KeyPoint.astro';
import Trick from '../Trick.astro';
import ExamTip from '../ExamTip.astro';
import ExamTags from '../ExamTags.astro';
import References from '../References.astro';
import ReportError from '../ReportError.astro';
import Byline from '../Byline.astro';
import LibgenCard from '../LibgenCard.astro';
import { url, absUrl, EXAMS } from '../../lib/site';
import { SECTIONS, resolveRelated, type TopicKey } from '../../lib/sections';
import { audienceLd, breadcrumbLd, faqLd, orgLd, personLd } from '../../lib/seo';

interface Props {
  entry: CollectionEntry<TopicKey>;
  section: TopicKey;
}

const { entry, section } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const info = SECTIONS[section];
const path = `${info.path}${entry.id}/`;
const family = d.family ? (await getCollection('mechanisms')).find((m) => m.id === d.family) : undefined;

// Related: explicit list, then other pages of the same category in this section.
const related = await resolveRelated(d.related, section);
if (related.length < 6) {
  const same = (await getCollection(section)).filter((e) => e.id !== entry.id && e.data.category === d.category).map((e) => `${section}/${e.id}`);
  for (const r of await resolveRelated(same)) {
    if (related.length >= 8) break;
    if (!related.some((x) => x.section === r.section && x.id === r.id)) related.push(r);
  }
}

const titleOptions: Record<TopicKey, string[]> = {
  concepts: [`${d.title}: Explanation, Examples & Exam Tips`, `${d.title}: Explanation & Examples`, `${d.title} Explained`, d.title],
  comparisons: [`${d.title}: Order, Reasons & Examples`, `${d.title}: Order & Reasons`, d.title],
  preparation: [`${d.title}: Methods, Reagents & Examples`, `${d.title}: Methods & Reagents`, d.title],
  reagents: [`${d.title}: Uses, Reactions & Mechanism`, `${d.title}: Uses & Reactions`, `${d.title} Reagent`, d.title],
};
const pageTitle = titleOptions[section].find((t) => t.length <= 65) ?? d.title;

const crumbs = [{ label: info.label, href: url(info.path) }, { label: d.title }];
const jsonLd = [
  {
    '@type': ['Article', 'LearningResource'],
    '@id': absUrl(`${path}#article`),
    headline: d.title,
    name: d.title,
    alternateName: d.aliases,
    description: d.description,
    url: absUrl(path),
    inLanguage: 'en-IN',
    image: absUrl('og-image.png'),
    author: personLd(),
    publisher: orgLd(),
    dateModified: d.verified.checked.toISOString().slice(0, 10),
    isAccessibleForFree: true,
    learningResourceType: section === 'comparisons' ? 'Comparison' : section === 'reagents' ? 'Reference' : 'Concept explanation',
    educationalLevel: 'Class 11–12, competitive entrance exams',
    audience: audienceLd,
    teaches: d.title,
    about: [{ '@type': 'Thing', name: d.title }, ...d.exams.map((e) => ({ '@type': 'Thing', name: EXAMS[e] }))],
    citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
  },
  breadcrumbLd([{ name: info.label, path: info.path }, { name: d.title, path }]),
  faqLd(d.faq, path),
].filter(Boolean) as Record<string, unknown>[];
---
<Base title={pageTitle} description={d.description} path={path} ogType="article" jsonLd={jsonLd} section={section}>
  <div class="container page">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <h1>{d.title}{d.formula && d.formula !== d.title && <span class="formula"> ({d.formula})</span>}</h1>
      {d.aliases.length > 0 && <p class="aka">Also called: {d.aliases.join(', ')}</p>}
      <div class="meta-row">
        <ExamTags exams={d.exams} />
        {d.verified.status === 'verified' && <span class="tag tag-ok">✓ Verified against {d.sources.length} sources</span>}
        {d.verified.status === 'conflict' && <span class="tag tag-warn">Under review</span>}
      </div>
      <p class="summary">{d.description}</p>
    </header>

    <div class="layout">
      <article class="prose">
        {d.molecule?.smiles && <div class="scheme"><Mol smiles={d.molecule.smiles} name={d.molecule.name} /></div>}
        <Content components={{ Eq, Mol, KeyPoint, Trick, ExamTip }} />

        {d.memoryTricks.length > 0 && (
          <Trick>
            <ul>
              {d.memoryTricks.map((t) => <li><strong>{t.text}</strong>{t.meaning && <> ({t.meaning})</>}</li>)}
            </ul>
          </Trick>
        )}

        {d.faq.length > 0 && (
          <section id="faq" aria-labelledby="faq-h">
            <h2 id="faq-h">Frequently asked questions</h2>
            <div class="faq">
              {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
            </div>
          </section>
        )}

        <References sources={d.sources} checked={d.verified.checked} status={d.verified.status} />
        <Byline notesPages={d.notesPages} updated={d.verified.checked} />
        <p><ReportError path={path} title={d.title} /></p>
        <LibgenCard />
      </article>

      <aside class="side">
        {family && (
          <div class="side-card">
            <h2>Part of</h2>
            <ul><li><a href={url(`mechanisms/${family.id}/`)}>{family.data.title}</a></li></ul>
          </div>
        )}
        {related.length > 0 && (
          <div class="side-card">
            <h2>Related pages</h2>
            <ul>{related.map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
          </div>
        )}
        <div class="side-card">
          <h2>Explore</h2>
          <ul>
            <li><a href={url(info.path)}>All {info.label.toLowerCase()}</a></li>
            <li><a href={url('reactions/')}>Reactions A–Z</a></li>
            <li><a href={url('map/')}>Interactive reaction map</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Base>
