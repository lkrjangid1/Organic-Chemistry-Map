---
import { url } from '../lib/site';
import { langOf, t as tr } from '../lib/i18n';
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const lang = langOf(Astro.url);
const all = [{ label: tr(lang).home, href: url(lang === 'hi' ? 'hi/' : '') }, ...items];
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((item, i) => (
      <li>{item.href && i < all.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
    ))}
  </ol>
</nav>
