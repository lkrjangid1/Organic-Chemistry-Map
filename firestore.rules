rules_version = '2';
// Each signed-in user can read and write only their own progress document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['flashcards', 'quizBest', 'saved', 'updatedAt'])
        && request.resource.data.flashcards is map
        && request.resource.data.flashcards.size() <= 2000
        && request.resource.data.quizBest is int
        && request.resource.data.saved is list
        && request.resource.data.saved.size() <= 500;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
